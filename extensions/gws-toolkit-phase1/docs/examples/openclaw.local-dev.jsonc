{
  "plugins": {
    "entries": {
      "gws-toolkit-phase1": {
        "enabled": true,
        "config": {
          "enabledServices": ["drive", "gmail", "calendar", "docs", "sheets", "contacts"],
          "enabledWriteServices": ["docs", "sheets", "contacts"],
          "allowWriteOperations": true,
          "allowUnboundAgents": false,
          "approvedCredentialDirs": ["./config/secrets/gws"],
          "credentialRoutes": {
            "local-main": {
              "mode": "token",
              "label": "Local dev token",
              "allowedServices": ["drive", "gmail", "calendar", "docs", "sheets", "contacts"],
              "allowedTools": [
                "gws_drive_read",
                "gws_gmail_read",
                "gws_calendar_read",
                "gws_docs_read",
                "gws_sheets_read",
                "gws_contacts_read",
                "gws_docs_write",
                "gws_sheets_write",
                "gws_contacts_write",
              ],
              "allowedActions": [
                "docs:append_text",
                "sheets:update_values",
                "contacts:list_contact_groups",
                "contacts:modify_contact_group_members",
              ],
              "tokenEnvVar": "GOOGLE_WORKSPACE_CLI_TOKEN",
            },
            // Directory Groups require delegated Google API transport. Enable
            // "groups" in enabledServices / enabledWriteServices and bind this
            // credentials_file route when testing Workspace group management.
            // "local-groups": {
            //   "mode": "credentials_file",
            //   "label": "Delegated Directory Groups route",
            //   "credentialsFile": "./config/secrets/gws/domain-wide-delegation.json",
            //   "allowedServices": ["groups"],
            //   "allowedTools": ["gws_groups_read", "gws_groups_write"],
            //   "allowedActions": ["groups:list_groups", "groups:add_group_member"],
            //   "impersonatedUser": "daisy.ai@example.com",
            // },
          },
          "agentCredentialBindings": {
            "agent:main": "local-main",
          },
        },
      },
    },
  },
}

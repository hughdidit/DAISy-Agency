{
  "name": "@openclaw/gws-toolkit-phase1",
  "version": "2026.3.2",
  "private": true,
  "description": "Security-hardened read-only Google Workspace toolkit plugin",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "test": "vitest run --config ../../vitest.extensions.config.ts test/**/*.test.ts",
    "test:acceptance": "vitest run --config ../../vitest.extensions.config.ts test/acceptance/*.test.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}

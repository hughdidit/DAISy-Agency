{
  "id": "memory-mongodb",
  "kind": "memory",
  "uiHints": {
    "mcp.transport": {
      "label": "MCP Transport",
      "placeholder": "stdio",
      "help": "Choose stdio for local MCP server or sse for remote endpoint"
    },
    "mcp.stdio.command": {
      "label": "MCP Command",
      "placeholder": "bundled default",
      "help": "Privileged override. Leave unset to launch the bundled pinned MongoDB MCP server"
    },
    "mcp.stdio.args": {
      "label": "MCP Command Args",
      "placeholder": "[\"<bundled mongodb-mcp-server entrypoint>\"]",
      "advanced": true,
      "help": "Privileged override. Leave unset to use the bundled pinned MongoDB MCP server entrypoint"
    },
    "mcp.stdio.allowCustomLauncher": {
      "label": "Allow Custom Launcher",
      "advanced": true,
      "help": "Unsafe escape hatch. Enable only when you intentionally need a non-bundled MongoDB MCP launcher"
    },
    "mcp.stdio.env.MDB_MCP_CONNECTION_STRING": {
      "label": "MongoDB Connection String",
      "sensitive": true,
      "placeholder": "${MONGODB_URI}",
      "help": "Atlas URI passed to the MongoDB MCP child. Other child env keys are restricted to approved TLS settings"
    },
    "mcp.url": {
      "label": "MCP SSE URL",
      "placeholder": "https://example.com/sse",
      "help": "Required when mcp.transport is sse"
    },
    "gemini.apiKey": {
      "label": "Gemini API Key",
      "sensitive": true,
      "placeholder": "AIza...",
      "help": "API key for Gemini embeddings"
    },
    "gemini.embeddingModel": {
      "label": "Embedding Model",
      "placeholder": "gemini-embedding-2-preview",
      "help": "Gemini embedding model to use"
    },
    "database.name": {
      "label": "Database Name",
      "placeholder": "daisy_memory",
      "advanced": true
    },
    "database.collection": {
      "label": "Collection Name",
      "placeholder": "memories",
      "advanced": true
    },
    "database.indexName": {
      "label": "Vector Search Index Name",
      "placeholder": "vector_index",
      "advanced": true
    },
    "retrieval.minScore": {
      "label": "Minimum Score",
      "placeholder": "0.1",
      "advanced": true
    },
    "retrieval.vectorLimit": {
      "label": "Vector Limit",
      "placeholder": "8",
      "advanced": true
    },
    "retrieval.numCandidatesMultiplier": {
      "label": "Candidates Multiplier",
      "placeholder": "10",
      "advanced": true
    },
    "captureTriggers": {
      "label": "Capture Triggers",
      "advanced": true,
      "help": "Array of regex patterns (case-insensitive) that trigger auto-capture"
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Automatically capture important information from conversations"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Automatically inject relevant memories into context"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mcp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transport": {
            "type": "string",
            "enum": ["stdio", "sse"]
          },
          "stdio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowCustomLauncher": { "type": "boolean" },
              "command": { "type": "string" },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "MDB_MCP_CONNECTION_STRING": { "type": "string" },
                  "NODE_EXTRA_CA_CERTS": { "type": "string" },
                  "NODE_USE_SYSTEM_CA": { "type": "string" },
                  "SSL_CERT_DIR": { "type": "string" },
                  "SSL_CERT_FILE": { "type": "string" }
                }
              }
            }
          },
          "url": {
            "type": "string"
          }
        },
        "required": []
      },
      "gemini": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": { "type": "string" },
          "embeddingModel": {
            "type": "string",
            "enum": ["gemini-embedding-2-preview"]
          }
        },
        "required": ["apiKey"]
      },
      "database": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "collection": { "type": "string" },
          "indexName": { "type": "string" }
        }
      },
      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minScore": { "type": "number" },
          "vectorLimit": { "type": "number" },
          "numCandidatesMultiplier": { "type": "number" }
        }
      },
      "captureTriggers": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Regex patterns (case-insensitive) that trigger auto-capture"
      },
      "autoCapture": { "type": "boolean" },
      "autoRecall": { "type": "boolean" }
    },
    "required": ["mcp", "gemini"]
  }
}

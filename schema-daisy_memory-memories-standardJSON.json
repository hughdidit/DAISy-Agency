{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "category",
    "createdAt",
    "importance",
    "metadata",
    "text",
    "type",
    "updatedAt",
    "vector"
  ],
  "properties": {
    "_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    },
    "importance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Double"
        },
        {
          "type": "integer"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string"
        },
        "ops": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "scopeSubject": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "confidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Double"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "observationCount": {
              "type": "integer"
            },
            "stabilityScore": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Double"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "owner": {
              "type": "string"
            },
            "dueAt": {
              "type": "integer"
            },
            "followUpAt": {
              "type": "integer"
            },
            "supersedesId": {
              "type": "string"
            },
            "expiresAt": {
              "type": "integer"
            },
            "auditRunId": {
              "type": "string"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "modality": {
                    "type": "string"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "contentHash": {
                    "type": "string"
                  },
                  "byteLength": {
                    "type": "integer"
                  },
                  "durationMs": {
                    "type": "integer"
                  },
                  "pageCount": {
                    "type": "integer"
                  },
                  "transcriptStatus": {
                    "type": "string"
                  },
                  "ocrStatus": {
                    "type": "string"
                  },
                  "storageMode": {
                    "type": "string"
                  },
                  "externalRef": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "subCategory": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "updatedAt": {
      "type": "integer"
    },
    "vector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Double"
      }
    }
  },
  "$defs": {
    "Double": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "$numberDouble": {
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          }
        }
      ]
    }
  }
}
